# Shovel configuration file.
#
# This file is optional. When present, it is merged over the settings you
# change in the UI, so you can customize the app declaratively. It is read
# from the app data dir (`~/.local/share/shovel/config.toml`) or from the
# current working directory.
#
# Every key is optional — omit what you do not want to override. A partial
# config only changes the settings it mentions; everything else keeps its
# current value.

# ════════════════════════════════════════════════════════════════════
# Appearance
# ════════════════════════════════════════════════════════════════════
theme = "Dark"            # "Dark" | "Light" | "System"
density = "Compact"       # "Compact" | "Normal" | "Comfortable"
split_mode = "Off"        # "Off" | "Horizontal" | "Vertical"

# ════════════════════════════════════════════════════════════════════
# Workspace & panels
# ════════════════════════════════════════════════════════════════════
default_page_size = 100
restore_session_on_launch = true
read_only_mode = false
ai_features_enabled = true
ai_auto_apply_completions = true

# Panel visibility on launch
show_saved_queries = true
show_connections = false
show_explorer = true
show_history = false
show_sql_editor = false
show_agent_panel = false
show_bottom_panel = true
bottom_panel_height = 120.0

# ════════════════════════════════════════════════════════════════════
# AI & language
# ════════════════════════════════════════════════════════════════════
ai_response_language = "English"

